# RedTeam environment template. Copy before first run:
#   cp .env.redteam.example .env.redteam
# .env.redteam is gitignored so real values can never be committed.

# Security Interlocks
MODE=REDTEAM
LOG_LEVEL=DEBUG

# The Kill Switch - If this is missing or altered, all adversarial suites abort
GOOGLE_API_KEY=MOCK_KEY_DO_NOT_CHARGE

# Service Endpoints for Isolated Compose Network
REDIS_URL=redis://redis:6379/0
DATABASE_URL=sqlite:///./workspaces/cleanocr.db
WORKSPACES_DIR=workspaces
UPLOAD_DIR=uploads
POPPLER_PATH=None

# Access Control Fuzzing Secrets
CLEANOCR_API_KEY=redteam_mock_secret_key_2026
RATE_LIMIT_UPLOADS_PER_MIN=3
RATE_LIMIT_STATUS_PER_MIN=60
RATE_LIMIT_WINDOW_SECONDS=60

# Mocked 3rd Party Services (Future Proofing)
STRIPE_KEY=mock_stripe
SMTP_PASSWORD=mock_smtp
