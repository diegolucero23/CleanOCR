# CleanOCR environment template.
# Copy to `.env` and fill in your values:   cp .env.example .env
# `.env` is gitignored — NEVER commit it. See SECURITY.md for key-handling
# policy, how to restrict the key's scope, and what to do if a key leaks.

# --- Required (standard / pro tiers) ---
# Gemini API key from https://aistudio.google.com/apikey — restrict it to the
# "Generative Language API" only (SECURITY.md § Key scoping).
# Set to MOCK_KEY_DO_NOT_CHARGE to run in mock mode with zero API spend.
GOOGLE_API_KEY=your-gemini-api-key-here

# --- Tier: standard | pro | local (local = Surya + Gemma, no Google key) ---
OCR_TIER=standard

# --- Models ---
MODEL_NAME=gemini-3.1-flash-lite
PRO_MODEL_NAME=gemini-3.8-flash
LAYOUT_MODEL_NAME=gemini-3.1-flash-lite
FALLBACK_MODEL_NAME=gemini-3.5-flash-lite
# LOCAL_GEMMA_MODEL=google/gemma-4-E4B-it
# Pin a HuggingFace commit hash for reproducible, tamper-resistant local-tier
# deployments (safetensors-only loading is always enforced).
# LOCAL_GEMMA_REVISION=

# --- Cost guard (0 disables a cap) ---
# Hard ceilings on billed Gemini calls so a retry/batching bug can't run up
# an unbounded bill. Daily cap is shared across workers via Redis; run cap
# is per-process and works even without Redis.
GEMINI_DAILY_CALL_CAP=2000
GEMINI_RUN_CALL_CAP=5000

# --- Infrastructure ---
REDIS_URL=redis://redis:6379/0
# POPPLER_PATH=C:\path\to\poppler\bin   # Windows only

# --- Upload limits ---
MAX_UPLOAD_MB=100
MAX_PDF_PAGES=500
WORKSPACE_TTL_HOURS=24

# --- Security & Access Control ---
# Leave blank for open local dev mode; set a secure key to enforce authentication.
# CLEANOCR_API_KEY=your-secret-api-key-here

# --- Rate Limiting ---
RATE_LIMIT_UPLOADS_PER_MIN=3
RATE_LIMIT_STATUS_PER_MIN=60
RATE_LIMIT_WINDOW_SECONDS=60
